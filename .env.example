# Copy to .env.local and fill in. See README for where each value comes from.

ANTHROPIC_API_KEY=
TEXT_PROVIDER=anthropic
OPENAI_API_KEY=

# Google OAuth client (Web application). Redirect URI: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000
MOCK_INBOX=true
